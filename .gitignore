# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# PHP admin config (contains credentials — use config.php.example as template)
public/admin/includes/config.php

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本機預覽用（由 out/ 複製並補上扁平 RSC 快取檔名，不應提交）
/preview-build/

# Python
__pycache__/
*.pyc

# ── 本地審計／流程產物（不入 repo：體積大、非原始碼）──────────────
# 只保留 deliverables/<日期>-<主題>/ 內的報告與數據，其餘截圖／原始素材／壓縮檔留在本機
.planning/
deliverables/iphone-audit-*/
deliverables/frontend-audit-*/
deliverables/site-images-*/
deliverables/*.zip
marker-fix-review.md

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# PHP admin config (contains credentials — use config.php.example as template)
public/admin/includes/config.php

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本機預覽用（由 out/ 複製並補上扁平 RSC 快取檔名，不應提交）
/preview-build/

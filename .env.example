# ─────────────────────────────────────────────────────────────────────────────
# ADWire Website — 環境變數配置範本
# ─────────────────────────────────────────────────────────────────────────────
# 複製此檔案為 .env.local 並填入實際值：
#   cp .env.example .env.local
#
# 這些變數在 Next.js Build Time 使用，用於從 Admin API 拉取最新數據。
# 如果未設定或 API 不可用，會自動 fallback 到本地硬編碼數據。
# ─────────────────────────────────────────────────────────────────────────────

# Admin API 基礎 URL（公開，會打包到前端 bundle）
NEXT_PUBLIC_API_URL=https://adwire.com.hk/admin/api

# Admin API 認證 Key（僅 Build Time 使用，不會暴露到前端）
# 對應 public/admin/includes/config.php 中的 ADMIN_API_KEY
ADMIN_API_KEY=
